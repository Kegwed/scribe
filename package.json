{
  "name": "@kegwed/scribe",
  "version": "0.1.1",
  "description": "Generates evidence-grounded onboarding docs for a repository and keeps them current.",
  "keywords": [
    "documentation",
    "onboarding",
    "docs",
    "llm",
    "claude",
    "cli",
    "codebase"
  ],
  "homepage": "https://github.com/Kegwed/scribe#readme",
  "bugs": {
    "url": "https://github.com/Kegwed/scribe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kegwed/scribe.git"
  },
  "license": "MIT",
  "author": "Kegwed",
  "type": "module",
  "bin": {
    "scribe": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && node scripts/check-recordings.mjs",
    "record": "node scripts/record-cassettes.mjs",
    "eval": "node scripts/eval.mjs",
    "measure": "node scripts/measure.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "prepack": "npm run build",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "ts-morph": "^28.0.0"
  }
}
